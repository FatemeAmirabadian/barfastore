generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = "postgresql://admin:admin123@localhost:5432/barfastore"
}

model Category {
  id       String    @id @default(uuid())
  name     String
  slug     String    @unique
  image    String
  url      String
  products Product[]
  @@index([slug])
}

model Product {
  id              String    @id @default(uuid())
  name            String?
  slug            String?   @unique
  images          Json?
  colors          String[]
  quantities      Int?
  price           Int?
  discountPercent Int?
  discountEnd     DateTime?
  createdAt       DateTime  @default(now())
  description     String?
  specs           Json?
  comments        Json      @default("[]")
  colorQuantities Json?
  categoryId      String?
  category        Category? @relation(fields: [categoryId], references: [id])
  @@index([categoryId])
  @@index([slug])
  @@index([createdAt])
}

model Article {
      id             String    @id @default(uuid())
      title          String?
      excerpt        String?
      image          String?
      slug           String?   @unique
      createdAt      DateTime @default(now())
      updatedAt      DateTime @updatedAt
}